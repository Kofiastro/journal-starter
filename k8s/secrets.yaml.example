apiVersion: v1
kind: Secret
metadata:
  name: journal-secrets
  labels:
    app: journal-api
type: Opaque
stringData:
  # Replace with your actual values before applying.
  DATABASE_URL: "postgresql://username:password@your-rds-endpoint:5432/journal"
  OPENAI_API_KEY: "replace-with-openai-api-key"
  OPENAI_BASE_URL: "replace-with-openai-base-url"
  OPENAI_MODEL: "gpt-4o-mini"
